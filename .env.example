## OpenClaw gateway token.
## Generate one with: openssl rand -hex 32
## Without this, the gateway will reject dashboard connections with
## "token mismatch" errors and you'll have to fish the token out of the
## container config by hand. Setting it here gives you a stable, predictable
## token that survives image rebuilds.
OPENCLAW_GATEWAY_TOKEN=

## LLM provider + model used by the agent.
##
## LLM_MODEL is a slug of the form "<provider>/<model>". The provider name
## (everything before the first "/") drives which OpenClaw plugin and auth
## profile get configured at startup. Examples:
##   openai/gpt-5
##   openai/gpt-4o-mini
##   openrouter/anthropic/claude-sonnet-4-6
##   nvidia/minimaxai/minimax-m2.7
##
## LLM_API_KEY is the matching provider's API key. Get one from:
##   OpenAI:     https://platform.openai.com/api-keys
##   OpenRouter: https://openrouter.ai/keys
##   NVIDIA:     https://build.nvidia.com/
##
## Switching providers means editing both lines here and running
## `docker compose up -d --force-recreate` — no code change required.
LLM_API_KEY=
LLM_MODEL=openai/gpt-5

## Telegram bot token (from BotFather: https://t.me/BotFather).
## Stored as a SecretRef in openclaw.json — the literal value lives only in
## .env and the running container's environment, never in the config volume.
TELEGRAM_BOT_TOKEN=

## Ripio account credentials (used by the ripio-login skill)
RIPIO_EMAIL=your-email-here
RIPIO_PASSWORD=your-password-here

## DCA configuration (used by the ripio-buy skill)
RIPIO_DCA_ASSET_ORIGIN=your-origin-asset
RIPIO_DCA_ASSET_TARGET=your-target-asset
